{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "metrics": {
    "namespace": "Igmo/Instance",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}",
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait",
          "cpu_usage_system",
          "cpu_usage_user"
        ],
        "metrics_collection_interval": 60,
        "totalcpu": true
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ]
      },
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "procstat": [
        {
          "pattern": "java -jar app.jar",
          "measurement": [
            "pid_count",
            "cpu_usage",
            "memory_rss"
          ],
          "metrics_collection_interval": 60
        }
      ]
    }
  },
  "logs": {
    "metrics_collected": {
      "prometheus": {
        "cluster_name": "igmo-prod",
        "log_group_name": "/igmo/prod/prometheus",
        "prometheus_config_path": "/opt/aws/amazon-cloudwatch-agent/etc/prometheus.yaml",
        "emf_processor": {
          "metric_declaration_dedup": true,
          "metric_namespace": "Igmo/App",
          "metric_unit": {
            "http_server_requests_seconds_count": "Count",
            "http_server_requests_seconds_sum": "Seconds",
            "http_server_requests_seconds_bucket": "Count",
            "jvm_memory_used_bytes": "Bytes",
            "jvm_memory_committed_bytes": "Bytes",
            "jvm_threads_live_threads": "Count",
            "jvm_threads_daemon_threads": "Count",
            "jvm_gc_pause_seconds_count": "Count",
            "jvm_gc_pause_seconds_sum": "Seconds",
            "process_cpu_usage": "None",
            "system_cpu_usage": "None",
            "application_ready_time_seconds": "Seconds",
            "application_started_time_seconds": "Seconds",
            "websocket_connection_active": "Count",
            "game_room_active": "Count",
            "websocket_broadcast_count_total": "Count",
            "websocket_broadcast_failure_total": "Count",
            "image_generation_duration_seconds_count": "Count",
            "image_generation_duration_seconds_sum": "Seconds",
            "image_generation_duration_seconds_max": "Seconds",
            "image_generation_failure_total": "Count",
            "image_upload_duration_seconds_count": "Count",
            "image_upload_duration_seconds_sum": "Seconds",
            "image_upload_duration_seconds_max": "Seconds",
            "image_upload_failure_total": "Count"
          },
          "metric_declaration": [
            {
              "source_labels": [
                "job",
                "service",
                "env"
              ],
              "label_matcher": "^igmo-app;igmo;prod$",
              "dimensions": [
                [
                  "service",
                  "env",
                  "job",
                  "instance"
                ]
              ],
              "metric_selectors": [
                "^http_server_requests_seconds_(count|sum|bucket)$",
                "^jvm_memory_(used|committed)_bytes$",
                "^jvm_threads_(live|daemon)_threads$",
                "^jvm_gc_pause_seconds_(count|sum)$",
                "^process_cpu_usage$",
                "^system_cpu_usage$",
                "^application_(ready|started)_time_seconds$",
                "^websocket_connection_active$",
                "^game_room_active$",
                "^websocket_broadcast_(count|failure)_total$",
                "^image_(generation|upload)_duration_seconds_(count|sum|max)$",
                "^image_(generation|upload)_failure_total$"
              ]
            }
          ]
        }
      }
    },
    "force_flush_interval": 5
  }
}
