{
  "annotations": {"list": []},
  "description": "WebSocket 연결, 게임 방과 Spring 메시지 전송 호출 결과를 확인한다.",
  "editable": false,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "현재 WebSocket 연결 수",
      "description": "현재 서버에 연결된 활성 WebSocket 세션 수다.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"},
      "targets": [{"expr": "sum(websocket_connection_active{application=~\".*\"})", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "현재 활성 게임 방 수",
      "description": "현재 서버 메모리에 유지되는 활성 게임 방 수다.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"},
      "targets": [{"expr": "sum(game_room_active{application=~\".*\"})", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "메시지 전송 처리량",
      "description": "Spring 메시지 전송 호출이 예외 없이 반환된 초당 건수다. ROOM_TOPIC과 PRIVATE_QUEUE를 구분해 표시하며, 클라이언트의 실제 수신 완료를 의미하지 않는다.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "auto", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum by (channelType) (rate(websocket_message_send_total{application=~\".*\",outcome=\"SUCCESS\"}[$__rate_interval]))", "legendFormat": "{{channelType}}", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "메시지 전송 실패 추이",
      "description": "구간별로 발생한 메시지 전송 예외 건수다. 공개 토픽과 개인 큐를 channelType으로 구분한다.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "custom": {"drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum by (channelType) (increase(websocket_message_send_total{application=~\".*\",outcome=\"FAILURE\"}[$__rate_interval]))", "legendFormat": "{{channelType}}", "refId": "A"}]
    },
    {
      "id": 5,
      "title": "메시지 타입별 전송 결과",
      "description": "선택한 조회 구간 동안 메시지 타입과 전송 경로별로 발생한 성공·실패 건수다.",
      "type": "barchart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 14},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"orientation": "auto", "xField": null, "xTickLabelRotation": 0, "xTickLabelSpacing": 0, "showValue": "auto", "stacking": "none", "groupWidth": 0.7, "barWidth": 0.97, "barRadius": 0, "fullHighlight": false, "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum by (messageType, channelType, outcome) (increase(websocket_message_send_total{application=~\".*\"}[$__range]))", "instant": true, "legendFormat": "{{messageType}} · {{channelType}} · {{outcome}}", "refId": "A"}]
    },
    {
      "id": 6,
      "title": "게임·메시지 처리 로그",
      "description": "게임 상태 전환, 게임 요청 처리 및 공개 토픽·개인 큐 메시지 전송 실패 로그다.",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false},
      "targets": [{"expr": "{service=\"igmo-backend\",environment=~\"$environment\"} | json | logger_name=~\"(com\\\\.igmo\\\\.web\\\\..*|com\\\\.igmo\\\\.service\\\\.(GamePhaseService|GameEventPublisher))\" | level=~\"$log_level\" | roomCode=~\"$room_code\" | event=~\"$event_type\" | fromPhase=~\"$from_phase\" | toPhase=~\"$to_phase\" |~ \"$log_keyword\" | line_format \"{{.level}} event={{.event}} roomCode={{.roomCode}} messageType={{.messageType}} fromPhase={{.fromPhase}} toPhase={{.toPhase}} exceptionType={{.exceptionType}} - {{.message}}\"", "refId": "A"}]
    },
    {
      "id": 7,
      "title": "Spring WebSocket 상태",
      "description": "Spring이 기록하는 WebSocket 세션, STOMP 처리량과 메시지 채널 상태 로그다.",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 34},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false},
      "targets": [{"expr": "{service=\"igmo-backend\",environment=~\"$environment\"} | json | logger_name=~\"org\\\\.springframework\\\\.web\\\\.socket.*\" | level=~\"$log_level\" |~ \"$log_keyword\" | line_format \"{{.level}} {{.logger_name}} - {{.message}}\"", "refId": "A"}]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["igmo", "websocket", "game"],
  "templating": {
    "list": [
      {"current": {"selected": true, "text": "production", "value": "production"}, "label": "환경", "name": "environment", "options": [{"selected": true, "text": "production", "value": "production"}, {"selected": false, "text": "local", "value": "local"}], "query": "production,local", "type": "custom"},
      {"current": {"selected": true, "text": ".*", "value": ".*"}, "label": "방 코드", "name": "room_code", "options": [{"selected": true, "text": ".*", "value": ".*"}], "query": ".*", "type": "textbox"},
      {"allValue": ".*", "current": {"selected": true, "text": "All", "value": "$__all"}, "includeAll": true, "label": "이벤트", "multi": true, "name": "event_type", "options": [], "query": "game_phase_transition_completed,room_broadcast_failed,private_event_send_failed,game_message_rejected,game_message_validation_failed,game_message_failed", "type": "custom"},
      {"allValue": ".*", "current": {"selected": true, "text": "All", "value": "$__all"}, "includeAll": true, "label": "이전 단계", "multi": true, "name": "from_phase", "options": [], "query": "LOBBY,GENERATING,PLAYING,VOTING,RESULTS,ENDED", "type": "custom"},
      {"allValue": ".*", "current": {"selected": true, "text": "All", "value": "$__all"}, "includeAll": true, "label": "이후 단계", "multi": true, "name": "to_phase", "options": [], "query": "LOBBY,GENERATING,PLAYING,VOTING,RESULTS,ENDED", "type": "custom"},
      {"allValue": ".*", "current": {"selected": true, "text": "All", "value": "$__all"}, "includeAll": true, "label": "로그 레벨", "multi": true, "name": "log_level", "options": [], "query": "DEBUG,INFO,WARN,ERROR", "type": "custom"},
      {"current": {"selected": true, "text": "", "value": ""}, "label": "로그 검색", "name": "log_keyword", "options": [{"selected": true, "text": "", "value": ""}], "query": "", "type": "textbox"}
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "WebSocket·게임 상태",
  "uid": "igmo-websocket-game",
  "version": 20
}
