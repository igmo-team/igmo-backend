{
  "annotations": {
    "list": []
  },
  "description": "WebSocket 연결과 게임 방 상태, 방 전체 메시지 전송 상태를 확인한다.",
  "editable": false,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "WebSocket 연결 수",
      "description": "현재 연결된 WebSocket 세션 수다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(websocket_connection_active{application=~\".*\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "진행 중인 게임 방",
      "description": "현재 메모리에 유지되는 활성 게임 방 수다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(game_room_active{application=~\".*\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "브로드캐스트 실패율",
      "description": "방 전체 토픽 메시지 전송 중 예외가 발생한 비율이다. 개인 큐 전송은 포함하지 않는다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(websocket_broadcast_failure_total{application=~\".*\"}[$__rate_interval])) / clamp_min(sum(rate(websocket_broadcast_count_total{application=~\".*\"}[$__rate_interval])) + sum(rate(websocket_broadcast_failure_total{application=~\".*\"}[$__rate_interval])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "브로드캐스트 처리량",
      "description": "초당 성공한 방 전체 토픽 메시지 전송 수다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(websocket_broadcast_count_total{application=~\".*\"}[$__rate_interval]))",
          "legendFormat": "성공",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "브로드캐스트 실패 건수",
      "description": "선택한 조회 구간 동안 방 전체 토픽 메시지 전송에서 발생한 예외 수다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(websocket_broadcast_failure_total{application=~\".*\"}[$__range]))",
          "legendFormat": "실패",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "게임 처리",
      "description": "게임 메시지 요청 거절, 처리 실패와 게임 상태 전환 로그다.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{service=\"igmo-backend\",environment=~\"$environment\"} | json | logger_name=~\"(com\\\\.igmo\\\\.web\\\\..*|com\\\\.igmo\\\\.service\\\\.GamePhaseService)\" | level=~\"$log_level\" |~ \"$log_keyword\" | line_format \"{{.level}} {{.logger_name}} - {{.message}}\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Spring WebSocket 상태",
      "description": "Spring이 기록하는 WebSocket 세션, STOMP 처리량과 메시지 채널 상태 로그다.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{service=\"igmo-backend\",environment=~\"$environment\"} | json | logger_name=~\"org\\\\.springframework\\\\.web\\\\.socket.*\" | level=~\"$log_level\" |~ \"$log_keyword\" | line_format \"{{.level}} {{.logger_name}} - {{.message}}\"",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "igmo",
    "websocket",
    "game"
  ],
