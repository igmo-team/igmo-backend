{
  "annotations": {"list": []},
  "description": "EC2 인스턴스와 node_exporter의 상태, 자원 사용량을 확인한다.",
  "editable": false,
  "id": null,
  "panels": [
    {"id": 1, "title": "호스트 지표 수집", "description": "Prometheus가 node_exporter에서 EC2 호스트 지표를 수집할 수 있는지 보여준다. DOWN이면 아래 호스트 지표를 신뢰할 수 없다.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}]}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}, "targets": [{"expr": "up{job=\"ec2-host\"}", "refId": "A"}]},
    {"id": 2, "title": "최근 부팅 시각", "description": "EC2가 마지막으로 부팅된 시각이다. 예기치 않은 변경은 인스턴스 재시작을 뜻할 수 있다.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0}, "fieldConfig": {"defaults": {"unit": "dateTimeAsLocal", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "mappings": []}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}, "targets": [{"expr": "node_boot_time_seconds{job=\"ec2-host\"} * 1000", "refId": "A"}]},
    {"id": 3, "title": "가동 시간", "description": "최근 EC2 부팅 후 경과 시간이다.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0}, "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "mappings": []}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}, "targets": [{"expr": "time() - node_boot_time_seconds{job=\"ec2-host\"}", "refId": "A"}]},
    {"id": 4, "title": "CPU 사용률", "description": "EC2 전체 CPU 사용률이다. t4g.small은 CPU credit 기반이므로 지속적인 고사용률을 확인해야 한다.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 0, "y": 6}, "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.85}]}, "mappings": []}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}, "targets": [{"expr": "1 - avg(rate(node_cpu_seconds_total{job=\"ec2-host\",mode=\"idle\"}[$__rate_interval]))", "refId": "A"}]},
    {"id": 5, "title": "메모리 사용률", "description": "EC2 전체 메모리 사용률이다. 2GiB 인스턴스에서 관측 컨테이너와 앱의 메모리 경합을 확인한다.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 8, "y": 6}, "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.85}]}, "mappings": []}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}, "targets": [{"expr": "1 - (node_memory_MemAvailable_bytes{job=\"ec2-host\"} / node_memory_MemTotal_bytes{job=\"ec2-host\"})", "refId": "A"}]},
    {"id": 6, "title": "루트 디스크 사용률", "description": "EBS 루트 파일시스템 사용률이다. Prometheus·Loki 데이터와 Docker 로그가 같은 디스크를 사용한다.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 8, "x": 16, "y": 6}, "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.85}]}, "mappings": []}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}, "targets": [{"expr": "1 - (node_filesystem_avail_bytes{job=\"ec2-host\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"ec2-host\",mountpoint=\"/\"})", "refId": "A"}]},
    {"id": 7, "title": "네트워크 처리량", "description": "EC2 네트워크 수신·송신 처리량이다. loopback과 Docker 가상 인터페이스는 제외한다.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "auto", "spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"expr": "sum(rate(node_network_receive_bytes_total{job=\"ec2-host\",device!~\"lo|docker.*|veth.*\"}[$__rate_interval]))", "legendFormat": "수신", "refId": "A"}, {"expr": "sum(rate(node_network_transmit_bytes_total{job=\"ec2-host\",device!~\"lo|docker.*|veth.*\"}[$__rate_interval]))", "legendFormat": "송신", "refId": "B"}]},
    {"id": 8, "title": "디스크 처리량", "description": "EC2 디스크 읽기·쓰기 처리량이다. Loki·Prometheus 보관 데이터가 I/O 병목을 만드는지 확인한다.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "auto", "spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"expr": "sum(rate(node_disk_read_bytes_total{job=\"ec2-host\",device!~\"loop.*|ram.*\"}[$__rate_interval]))", "legendFormat": "읽기", "refId": "A"}, {"expr": "sum(rate(node_disk_written_bytes_total{job=\"ec2-host\",device!~\"loop.*|ram.*\"}[$__rate_interval]))", "legendFormat": "쓰기", "refId": "B"}]}
  ],
  "refresh": "30s",
