    {
      "id": 6,
      "title": "서버 오류 비율",
      "description": "전체 HTTP 요청 중 5xx 응답 비율이다. 1%부터 위험으로 표시한다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\".*\",status=~\"5..\",uri!=\"/actuator/prometheus\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=~\".*\",uri!=\"/actuator/prometheus\"}[$__rate_interval])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "느린 요청",
      "description": "URI별 p95·p99 처리 시간이다. 사용자 체감 지연을 확인한다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=~\".*\",uri!=\"/actuator/prometheus\"}[$__rate_interval])))",
          "legendFormat": "p95 {{uri}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=~\".*\",uri!=\"/actuator/prometheus\"}[$__rate_interval])))",
          "legendFormat": "p99 {{uri}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "응답 상태",
