{
  "annotations": {
    "list": []
  },
  "description": "Spring Boot 앱의 기동 상태, HTTP 품질, JVM, 이미지 생성과 로그를 확인한다.",
  "editable": false,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "앱 지표 수집",
      "description": "Prometheus가 앱의 /actuator/prometheus endpoint에 연결할 수 있는지 보여준다. UP은 endpoint 응답 가능 상태다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"igmo-app\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "앱 시작 시각",
      "description": "Spring Boot 프로세스가 마지막으로 시작된 시각이다. 변경되면 앱 컨테이너가 재시작된 것이다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "process_start_time_seconds{job=\"igmo-app\"} * 1000",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
