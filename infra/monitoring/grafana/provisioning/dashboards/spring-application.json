    {
      "id": 4,
      "title": "누적 요청 수",
      "description": "앱 시작 이후 처리한 HTTP 요청 수다. Prometheus 수집 endpoint 요청은 제외한다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 6
