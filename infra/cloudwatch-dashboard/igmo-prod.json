        "query": "SOURCE '/igmo/prod/app' | fields @timestamp, requestId, method, normalizedPath, status, durationMs, message\n| filter status >= 500 and not (normalizedPath like /\\/actuator\\// or path like /\\/actuator\\//)\n| sort @timestamp desc\n| limit 50",
