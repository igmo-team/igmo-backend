    {
      "type": "log",
      "x": 0,
      "y": 6,
      "width": 16,
      "height": 6,
      "properties": {
        "region": "ap-northeast-2",
        "title": "분당 일반 요청 수 추세",
        "query": "SOURCE '/igmo/prod/app' | filter ispresent(status) and not (normalizedPath like /\\/actuator\\// or path like /\\/actuator\\//)\n| stats count(*) as requests by bin(1m) as time\n| sort time asc",
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "x": 16,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "region": "ap-northeast-2",
        "title": "상태 코드별 요청 수 합계",
        "query": "SOURCE '/igmo/prod/app' | filter ispresent(status) and not (normalizedPath like /\\/actuator\\// or path like /\\/actuator\\//)\n| stats count(*) as requests by status\n| sort requests desc",
        "view": "table"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "ap-northeast-2",
        "title": "요청 지연시간 P95/P99",
        "query": "SOURCE '/igmo/prod/app' | filter ispresent(durationMs) and not (normalizedPath like /\\/actuator\\// or path like /\\/actuator\\//)\n| stats pct(durationMs, 95) as p95, pct(durationMs, 99) as p99, avg(durationMs) as avg by bin(1m) as time\n| sort time asc",
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "ap-northeast-2",
        "title": "상태 코드 그룹별 요청 수 추세",
        "query": "SOURCE '/igmo/prod/app' | fields status\n| filter ispresent(status) and not (normalizedPath like /\\/actuator\\// or path like /\\/actuator\\//)\n| fields if(status >= 500, \"5xx\", if(status >= 400, \"4xx\", if(status >= 300, \"3xx\", \"2xx\"))) as statusGroup\n| stats count(*) as requests by bin(1m) as time, statusGroup\n| sort time asc",
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 18,
      "width": 24,
      "height": 6,
      "properties": {
        "region": "ap-northeast-2",
        "title": "경로별 요청 지연시간 P95/P99",
        "query": "SOURCE '/igmo/prod/app' | filter ispresent(durationMs) and not (normalizedPath like /\\/actuator\\// or path like /\\/actuator\\//)\n| stats count(*) as requests, pct(durationMs, 95) as p95, pct(durationMs, 99) as p99, avg(durationMs) as avg, max(durationMs) as max by normalizedPath\n| sort p99 desc\n| limit 20",
        "view": "table"
      }
    },
